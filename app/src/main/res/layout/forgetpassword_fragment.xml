<?xml version="1.0" encoding="utf-8"?><RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    xmlns:tools="http://schemas.android.com/tools"    android:id="@+id/forget_email"    android:layout_width="match_parent"    android:layout_height="match_parent">    <LinearLayout        android:layout_width="match_parent"        android:layout_height="match_parent"        android:orientation="vertical">        <com.google.android.material.textfield.TextInputLayout            android:id="@+id/etPassword"            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:textColorHint="@color/colorPrimary"            app:hintEnabled="false"            android:layout_margin="@dimen/padding16dp"            app:passwordToggleEnabled="true">            <EditText                android:id="@+id/password_editText"                android:layout_width="match_parent"                android:layout_height="wrap_content"                android:layout_gravity="center"                android:layout_weight="1"                android:background="@drawable/normal_edittext_blue"                android:hint="กรอกรหัสผ่าน 4-15 ตัว"                android:inputType="textPassword"                android:maxLength="15"                android:minEms="4"                android:textColor="@color/black"                android:textColorHint="#dad2d2" />        </com.google.android.material.textfield.TextInputLayout>        <com.google.android.material.textfield.TextInputLayout            android:id="@+id/etRePassword"            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:textColorHint="@color/colorPrimary"            app:hintEnabled="false"            android:layout_margin="@dimen/padding16dp"            app:passwordToggleEnabled="true">            <EditText                android:id="@+id/forget_password_editText"                android:layout_width="match_parent"                android:layout_height="wrap_content"                android:layout_gravity="center"                android:layout_weight="1"                android:background="@drawable/normal_edittext_blue"                android:hint="กรอกยืนยันรหัสผ่าน 4-15 ตัว"                android:inputType="textPassword"                android:maxLength="15"                android:minEms="4"                android:textColor="@color/black"                android:textColorHint="#dad2d2" />        </com.google.android.material.textfield.TextInputLayout>        <Button            android:id="@+id/btn_save"            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:layout_margin="@dimen/padding16dp"            android:background="@drawable/btn_blue"            android:text="ยืนยัน"            android:textColor="@color/white"            android:textSize="18sp"            android:textStyle="bold"            tools:ignore="MissingConstraints" />    </LinearLayout>    <LinearLayout        android:id="@+id/llviewlooad"        android:layout_width="match_parent"        android:layout_height="match_parent"        android:background="#88888888"        android:clickable="true"        android:gravity="center"        android:orientation="vertical"        android:visibility="gone">        <com.github.ybq.android.spinkit.SpinKitView xmlns:app="http://schemas.android.com/apk/res-auto"            android:id="@+id/spin_kit"            style="@style/SpinKitView.Large.Circle"            android:layout_width="wrap_content"            android:layout_height="wrap_content"            android:layout_gravity="center"            app:SpinKit_Color="@color/colorAccent" />    </LinearLayout></RelativeLayout>