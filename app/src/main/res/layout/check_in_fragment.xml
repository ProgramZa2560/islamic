<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/background"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/margin8dp">


        <LinearLayout
            android:padding="@dimen/margin8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/address12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nameplace"
                    android:textColor="#001273"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    />

                <EditText
                    android:id="@+id/editTextNameplace"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:ems="10"
                    android:hint=""
                    android:paddingStart="@dimen/margin8dp"
                    android:layout_marginLeft="@dimen/margin8dp"
                    android:background="@drawable/button_normal"
                    android:inputType="textShortMessage|textLongMessage|textPersonName" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_margin="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewMaps"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_action_maps" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ตำแหน่งที่ตั้ง : "
                    android:textColor="#001273"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10.00000, 100.4445555"
                    android:textColor="#001273"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/address14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manyroom"
                    android:textColor="#001273"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/editTextNumberRoom"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="45dp"
                    android:autofillHints="0"
                    android:textAlignment="textEnd"
                    android:ems="10"
                    android:hint="0"
                    android:background="@drawable/button_normal"
                    android:layout_marginLeft="@dimen/margin8dp"
                    android:paddingEnd="@dimen/margin8dp"
                    android:inputType="number" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="ห้อง"
                    android:layout_marginLeft="@dimen/margin8dp"
                    android:textColor="#001273"
                    android:textSize="14sp"
                    android:textStyle="bold"/>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/address15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_rongrup1room"
                    android:textColor="#001273"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.062"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.564" />


                <EditText
                    android:id="@+id/editTextNumber"
                    android:layout_width="0dp"
                    android:layout_height="47dp"
                    android:layout_marginLeft="@dimen/margin8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_normal"
                    android:ems="10"
                    android:hint="0"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingEnd="@dimen/margin8dp"
                    android:textAlignment="textEnd" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin8dp"
                    android:text="คน"
                    android:textColor="#001273"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:orientation="horizontal">


                <EditText
                    android:id="@+id/editTextDesc"
                    android:layout_width="0dp"
                    android:layout_height="47dp"
                    android:layout_marginLeft="@dimen/margin8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_normal"
                    android:ems="10"
                    android:hint="รายละเอียดเพิ่มเติม"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingEnd="@dimen/margin8dp"
                    android:paddingStart="@dimen/margin8dp"
                    android:textAlignment="textStart" />



            </LinearLayout>

            <LinearLayout
                android:layout_margin="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView1"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/frame"/>
                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/frame"/>
                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/frame"/>



            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/margin8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingRight="@dimen/sizetext14sp"
                android:orientation="horizontal">


                <Button
                    android:layout_marginEnd="2dp"
                    android:id="@+id/bt_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_ok"
                    android:text="บันทึก"
                    android:textAlignment="center"
                    android:textColor="@color/white" />

                <Button
                    android:layout_marginStart="2dp"
                    android:id="@+id/bt_can"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_red"
                    android:text="ยกเลิก"
                    android:textAlignment="center"
                    android:textColor="@color/white"/>



            </LinearLayout>



        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/llviewlooad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#88888888"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <com.github.ybq.android.spinkit.SpinKitView xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/spin_kit"
                    style="@style/SpinKitView.Large.Circle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:SpinKit_Color="@color/colorAccent" />

            </LinearLayout>
        </RelativeLayout>


    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>