<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:padding="@dimen/padding16dp"
    android:orientation="vertical"
    android:background="@drawable/background"
    android:layout_height="match_parent">

    <TextView

        android:id="@+id/aboutapp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aboutapp"
        android:textColor="#001171"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/padding16dp"/>

    <TextView

        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_normal"
        android:padding="@dimen/padding16dp"
        android:text="       แอปพลิเคชันค้นหาสถานที่ละหมาด เป็นแอปพลิเคชันสำหรับ การค้นหาสถานที่ละหมาดสำหรับชาวมุสลิมในประเทศไทย พร้อมทั้ง บอกรายละเอียดข้อมูลของสถานที่ละหมาด มีข้อมูลของเวลาละหมาด  มีการแจ้งเตือนเมื่อถึงเวลาละหมาด และผู้ใช้สามารถเพิ่มสถานที่ละหมาด ที่ไม่มีอยู่ในแอปพลิเคชันได้เอง"
        android:textAlignment="textStart"
        android:textColor="#002968"
        android:textSize="16sp"
        android:visibility="visible" />
</LinearLayout>