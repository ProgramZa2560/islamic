<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    xmlns:tools="http://schemas.android.com/tools"    android:id="@+id/forget_email"    android:layout_width="match_parent"    android:layout_height="match_parent"    android:orientation="vertical">    <EditText        android:id="@+id/message"        android:layout_width="match_parent"        android:layout_height="50dp"        android:layout_margin="@dimen/padding16dp"        android:background="@drawable/normal_edittext_blue"        android:hint="กรุณากรอกอีเมล"        app:layout_constraintBottom_toBottomOf="parent"        app:layout_constraintEnd_toEndOf="parent"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toTopOf="parent" />    <Button        android:layout_width="match_parent"        android:layout_height="wrap_content"        android:layout_margin="@dimen/padding16dp"        android:background="@drawable/btn_blue"        android:text="ถัดไป"        android:textColor="@color/white"        android:textSize="18sp"        android:textStyle="bold"        tools:ignore="MissingConstraints" /></LinearLayout>