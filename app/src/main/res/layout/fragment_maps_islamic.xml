<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.suks.sittiporn.lslamic.features.maps.MapWrapperLayout xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/map_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="MissingClass">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context="com.example.mapcustommarker.CustomInfoWindowMapsActivity" />

    </com.suks.sittiporn.lslamic.features.maps.MapWrapperLayout>


    <ImageButton
        android:id="@+id/searchMaps"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@color/transparent"
        android:src="@drawable/ic_list_maps"
        android:tint="@color/black" />

    <ImageButton
        android:layout_marginLeft="@dimen/margin8dp"
        android:layout_below="@id/searchMaps"
        android:id="@+id/refresh"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitXY"
        android:background="@color/transparent"
        android:src="@drawable/ic_baseline_refresh_b_64"
        android:tint="@color/black" />

</RelativeLayout>
